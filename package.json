{
  "name": "hanyu-pinyin-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome and Edge extension that annotates Chinese text with Hanyu Pinyin.",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "store:generate": "node scripts/store-assets/generate.mjs",
    "build": "npm run store:generate && node scripts/build.mjs",
    "dev": "npm run store:generate && node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "store:validate": "node scripts/validate-store-assets.mjs",
    "check": "tsc --noEmit && npm test && npm run build && npm run store:validate"
  },
  "dependencies": {
    "@pinyin-pro/data": "^1.3.1",
    "pinyin-pro": "^3.29.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "sharp": "^0.34.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
